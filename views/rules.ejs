<% var title = 'Rules'; var active = 'rules' %>
<%- include('partials/header') %>
<h1>Rules</h1>
<p class="muted">Match play under the Rules of Golf, with a few sensible concessions to the fact that this is eight friends and not a qualifying event.</p>

<a class="card" style="display:block; text-decoration:none; color:inherit; border: 2px solid var(--gold);" href="/rules/official">
  <div class="flex between">
    <div>
      <h2 class="mb0">🤖 The Rules Official</h2>
      <p class="small muted" style="margin:6px 0 0;">Stuck on a ruling mid-round? Ask the AI ref — it knows these rules cold. Captains still have final say.</p>
    </div>
  </div>
</a>

<div class="card">
  <ul class="rules-list">
    <% rules.forEach(function(r) { %>
      <li><strong><%= r.title %></strong> <%= r.text %></li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
