<% var title = course.name; var active = 'courses' %>
<%- include('partials/header') %>
<p><a href="/courses">← Courses</a></p>
<h1><%= course.name %></h1>
<p class="muted small">Par <%= totalPar %> · Stroke index = difficulty rank (1 = hardest hole, gets handicap strokes first)</p>

<div class="card">
  <% if (user.is_admin) { %>
  <form method="post" action="/courses/<%= course.id %>/holes">
  <% } %>
  <table>
    <thead><tr><th>Hole</th><th>Par</th><th>SI</th></tr></thead>
    <tbody>
      <% holes.forEach(function(h) { %>
        <tr>
          <td><%= h.hole_number %></td>
          <td>
            <% if (user.is_admin) { %>
              <select name="par[<%= h.hole_number %>]" style="width:64px; padding:6px;">
                <% [3,4,5].forEach(function(p) { %>
                  <option value="<%= p %>" <%= h.par === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            <% } else { %><%= h.par %><% } %>
          </td>
          <td>
            <% if (user.is_admin) { %>
              <input type="number" min="1" max="18" name="stroke_index[<%= h.hole_number %>]" value="<%= h.stroke_index %>" style="width:56px; padding:6px;" />
            <% } else { %><%= h.stroke_index %><% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!holes.length) { %><tr><td colspan="3" class="muted small">No holes configured yet.</td></tr><% } %>
    </tbody>
  </table>
  <% if (user.is_admin) { %>
    <button class="btn mt" type="submit">Save course</button>
    <p class="small muted mt">Stroke index must be a unique 1-18 (each hole a different difficulty rank) — if it isn't, I'll reset it to hole order for you.</p>
  </form>
  <% } %>
</div>

<%- include('partials/footer') %>
