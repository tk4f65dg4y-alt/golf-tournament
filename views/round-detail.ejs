<% var title = round.name; var active = 'rounds' %>
<%- include('partials/header') %>
<p><a href="/rounds">← All rounds</a></p>
<h1><%= round.name %></h1>
<p class="muted"><%= round.course_name || round.course || '' %><% if (round.round_date) { %> · <%= new Date(round.round_date).toLocaleDateString(undefined, {month:'long', day:'numeric', year:'numeric'}) %><% } %></p>

<div class="card">
  <% if (round.course_id && round.hasFullCourse) { %>
    <p class="mb0">⛳ <strong><%= round.course_name %></strong> is set — matches in this round auto-score from real handicap strokes. <a href="/courses/<%= round.course_id %>">View/edit holes</a></p>
  <% } else if (round.course_id) { %>
    <p class="mb0">⚠️ <strong><%= round.course_name %></strong> is assigned but doesn't have all 18 holes configured yet — matches will use manual scoring until it's finished. <a href="/courses/<%= round.course_id %>">Finish course setup</a></p>
  <% } else { %>
    <p class="mb0">No course assigned to this round yet — matches use manual "tap who won the hole" scoring. Assign one for automatic handicap-based scoring.</p>
  <% } %>
  <% if (user.is_admin) { %>
  <form method="post" action="/rounds/<%= round.id %>/course" class="flex gap mt wrap">
    <select name="course_id" style="width:auto; flex:1; min-width:180px;">
      <option value="">— none —</option>
      <% courses.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= round.course_id === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <button class="btn small" type="submit">Set course</button>
  </form>
  <% } %>
</div>

<% matches.forEach(function(m) { %>
  <div class="card">
    <div class="flex between">
      <div>
        <span class="tag"><%= m.format %></span>
        <span class="tag"><%= m.points %> pt<%= Number(m.points) !== 1 ? 's' : '' %></span>
      </div>
      <% if (user.is_admin) { %>
        <form method="post" action="/rounds/<%= round.id %>/matches/<%= m.id %>/delete" onsubmit="return confirm('Delete this match?')">
          <button class="btn danger small" type="submit">Delete</button>
        </form>
      <% } %>
    </div>
    <div class="match-row" style="border-bottom:none; padding-bottom:0;">
      <div>
        <div class="match-side"><%= playerNames(m.side1) || 'TBD' %></div>
        <div class="muted small">vs</div>
        <div class="match-side"><%= playerNames(m.side2) || 'TBD' %></div>
      </div>
      <div class="match-status">
        <% if (m.statusInfo.isComplete) { %><span class="pill complete"><%= m.statusInfo.closedNote %></span>
        <% } else if (m.statusInfo.thru > 0) { %><span class="pill live">LIVE</span><br/><%= m.statusInfo.statusText %>
        <% } else { %><span class="pill scheduled">Not started</span><% } %>
      </div>
    </div>
    <a class="btn secondary small mt" href="/matches/<%= m.id %>">Open scorecard →</a>
  </div>
<% }) %>

<% if (!matches.length) { %><div class="card"><p class="muted">No matches scheduled for this round yet.</p></div><% } %>

<% if (user.is_admin) { %>
<div class="card">
  <h2>Add a match</h2>
  <form method="post" action="/rounds/<%= round.id %>/matches">
    <div class="grid-2">
      <div class="field">
        <label>Format</label>
        <select name="format">
          <option value="singles">Singles</option>
          <option value="fourball">Fourball (better ball)</option>
          <option value="foursomes">Foursomes (alternate shot)</option>
          <option value="scramble">Scramble</option>
        </select>
      </div>
      <div class="field"><label>Points</label><input type="number" step="0.5" min="0.5" name="points" value="1" /></div>
    </div>
    <div class="grid-2">
      <div class="field">
        <label>Side 1 players</label>
        <div class="checkbox-list">
          <% users.forEach(function(u) { %>
            <label><input type="checkbox" name="side1" value="<%= u.id %>" /> <%= u.is_captain ? '👑 ' : '' %><%= u.name %></label>
          <% }) %>
        </div>
      </div>
      <div class="field">
        <label>Side 2 players</label>
        <div class="checkbox-list">
          <% users.forEach(function(u) { %>
            <label><input type="checkbox" name="side2" value="<%= u.id %>" /> <%= u.is_captain ? '👑 ' : '' %><%= u.name %></label>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="field"><label>Notes (optional)</label><input type="text" name="notes" placeholder="Tee time, hole, etc." /></div>
    <button class="btn" type="submit">Add match</button>
  </form>
</div>
<% } %>

<%- include('partials/footer') %>
