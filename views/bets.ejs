<% var title = 'Bets'; var active = 'bets' %>
<%- include('partials/header') %>
<h1>🎲 Bets</h1>
<p class="muted small">Propose a claim, someone else matches it, it settles itself the moment the real result happens — even mid-hole. Custom ones get settled by a captain. No PIN needed to join — share <strong>/bet-in</strong> with anyone who wants in.</p>

<% if (!user.readOnly) { %>
<div class="card">
  <h2>Propose a bet</h2>
  <form method="post" action="/bets" id="bet-form">
    <div class="field">
      <label>Market</label>
      <select name="kind" id="kind-select">
        <option value="hole">Hole winner (in-play)</option>
        <option value="match">Match winner</option>
        <option value="cup">Cup winner</option>
        <option value="pars">Over/under pars</option>
        <option value="custom">Custom — anything else</option>
      </select>
    </div>

    <div data-kind="cup" class="kind-block">
      <div class="field">
        <label>Team</label>
        <select name="side">
          <option value="A">Team Casey win the Cup</option>
          <option value="B">Team Reggel win the Cup</option>
        </select>
      </div>
    </div>

    <div data-kind="match" class="kind-block" hidden>
      <div class="grid-2">
        <div class="field">
          <label>Match</label>
          <select name="matchId">
            <% matchOptions.forEach(function(m) { %><option value="<%= m.id %>">Match <%= m.id %>: <%= m.label %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label>Who wins?</label>
          <select name="side">
            <option value="A">Side A (Casey pairing)</option>
            <option value="B">Side B (Reggel pairing)</option>
            <option value="half">Halved</option>
          </select>
        </div>
      </div>
    </div>

    <div data-kind="hole" class="kind-block" hidden>
      <div class="grid-2">
        <div class="field">
          <label>Match</label>
          <select name="matchId">
            <% matchOptions.forEach(function(m) { %><option value="<%= m.id %>">Match <%= m.id %>: <%= m.label %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>Hole</label><input type="number" name="holeNumber" min="1" max="18" placeholder="7" /></div>
      </div>
      <div class="field">
        <label>Who wins that hole?</label>
        <select name="side">
          <option value="A">Side A (Casey pairing)</option>
          <option value="B">Side B (Reggel pairing)</option>
          <option value="half">Halved</option>
        </select>
      </div>
    </div>

    <div data-kind="pars" class="kind-block" hidden>
      <div class="grid-2">
        <div class="field">
          <label>Match</label>
          <select name="matchId">
            <% matchOptions.forEach(function(m) { %><option value="<%= m.id %>">Match <%= m.id %>: <%= m.label %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label>Player</label>
          <select name="playerId">
            <% players.forEach(function(p) { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="grid-2">
        <div class="field">
          <label>Gross or net</label>
          <select name="scoreType"><option value="gross">Gross</option><option value="net">Net</option></select>
        </div>
        <div class="field"><label>Line (use a .5 to avoid ties)</label><input type="number" step="0.5" name="line" placeholder="84.5" /></div>
      </div>
      <div class="field">
        <label>Over or under?</label>
        <select name="overUnder"><option value="over">Over</option><option value="under">Under</option></select>
      </div>
      <p class="small muted">Settles once every hole in that match has a real score for that player — if the match ends early and they don't play it out, this one just stays open.</p>
    </div>

    <div data-kind="custom" class="kind-block" hidden>
      <div class="field"><label>Your claim</label><input type="text" name="claim" maxlength="200" placeholder="Solly to break 100" /></div>
      <p class="small muted">No live data to check this against — a captain settles it by hand once it's known.</p>
    </div>

    <div class="grid-2">
      <div class="field"><label>Your name</label><input type="text" name="proposerName" maxlength="40" value="<%= defaultName %>" placeholder="Whoever's asking" required /></div>
      <div class="field"><label>Stake</label>
        <div class="flex gap">
          <input type="number" name="stakeAmount" min="0.5" step="0.5" placeholder="5" required style="flex:2;" />
          <input type="text" name="stakeUnit" value="£" maxlength="8" style="flex:1;" />
        </div>
      </div>
    </div>
    <button class="btn block" type="submit">Propose bet →</button>
  </form>
</div>
<% } %>

<div class="card">
  <h2>Open — waiting for a taker</h2>
  <% open.forEach(function(w) { %>
    <div class="match-row" style="flex-direction:column; align-items:stretch;">
      <div class="flex between">
        <div>
          <p class="mb0" style="font-weight:700;"><%= w.claim %></p>
          <p class="small muted mb0"><%= w.proposer_name %> backs it for <%= w.stake_unit %><%= w.stake_amount %></p>
        </div>
        <span class="tag"><%= w.kind %></span>
      </div>
      <% if (!user.readOnly) { %>
      <div class="flex gap mt wrap">
        <form method="post" action="/bets/<%= w.id %>/match" class="flex gap">
          <input type="text" name="matcherName" placeholder="Your name" maxlength="40" value="<%= defaultName %>" required style="width:140px;" />
          <button class="btn small" type="submit">Take it →</button>
        </form>
        <form method="post" action="/bets/<%= w.id %>/cancel">
          <button class="btn danger small" type="submit">Withdraw</button>
        </form>
      </div>
      <% } %>
    </div>
  <% }) %>
  <% if (!open.length) { %><p class="muted small mb0">Nothing open right now.</p><% } %>
</div>

<div class="card">
  <h2>Live — matched, waiting on the result</h2>
  <% matched.forEach(function(w) { %>
    <div class="match-row" style="flex-direction:column; align-items:stretch;">
      <p class="mb0" style="font-weight:700;"><%= w.claim %></p>
      <p class="small muted mb0"><%= w.proposer_name %> (for it) v <%= w.matcher_name %> (against) · <%= w.stake_unit %><%= w.stake_amount %></p>
      <% if (user.isCaptain) { %>
      <form method="post" action="/bets/<%= w.id %>/settle" class="flex gap mt wrap">
        <button class="btn small" type="submit" name="winner" value="proposer"><%= w.proposer_name %> won</button>
        <button class="btn small gold" type="submit" name="winner" value="matcher"><%= w.matcher_name %> won</button>
        <span class="small muted">captain override</span>
      </form>
      <% } %>
    </div>
  <% }) %>
  <% if (!matched.length) { %><p class="muted small mb0">No live bets right now.</p><% } %>
</div>

<div class="card">
  <h2>Settled</h2>
  <% settled.forEach(function(w) { %>
    <% if (w.status === 'void') { %>
      <div class="match-row"><div><span class="tag">void</span> <%= w.claim %></div></div>
    <% } else {
      var winnerName = w.result === 'proposer_won' ? w.proposer_name : w.matcher_name;
      var loserName = w.result === 'proposer_won' ? w.matcher_name : w.proposer_name;
    %>
      <div class="match-row" style="flex-direction:column; align-items:stretch;">
        <p class="mb0" style="font-weight:700;"><%= w.claim %></p>
        <p class="small mb0"><span class="pill complete">🏆 <%= winnerName %></span> wins <%= w.stake_unit %><%= w.stake_amount %> from <%= loserName %></p>
        <p class="small muted mb0"><%= w.settle_note %></p>
      </div>
    <% } %>
  <% }) %>
  <% if (!settled.length) { %><p class="muted small mb0">Nothing settled yet.</p><% } %>
</div>

<script>
(function () {
  var kindSelect = document.getElementById('kind-select');
  function sync() {
    document.querySelectorAll('.kind-block').forEach(function (el) {
      var active = el.getAttribute('data-kind') === kindSelect.value;
      el.hidden = !active;
      // Every kind-block has its own name="side"/name="matchId" etc. A
      // hidden block is still submitted with the form unless its fields are
      // disabled too — leaving them enabled means side/matchId arrive as
      // arrays (one value per block) and Number(['1','1']) is NaN, so the
      // match lookup silently fails and nothing gets created.
      el.querySelectorAll('input, select, textarea').forEach(function (field) {
        field.disabled = !active;
      });
    });
  }
  if (kindSelect) {
    kindSelect.addEventListener('change', sync);
    sync();
  }

  // "Live" refresh so open/matched/settled lists stay current without anyone
  // having to reload by hand — but never while someone's mid-way through the
  // propose-bet form, or a page reload wipes out whatever they'd typed so
  // far (a plain <meta refresh> did exactly that, and only the shortest
  // markets like "hole" ever finished in time).
  var form = document.getElementById('bet-form');
  var formTouched = false;
  if (form) {
    ['input', 'change'].forEach(function (evt) {
      form.addEventListener(evt, function () { formTouched = true; });
    });
    form.addEventListener('submit', function () { formTouched = false; });
  }
  setInterval(function () {
    if (!formTouched) location.reload();
  }, 15000);
})();
</script>

<%- include('partials/footer') %>
