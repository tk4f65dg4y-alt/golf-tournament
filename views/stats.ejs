<% var title = 'Stats'; var active = 'stats' %>
<%- include('partials/header') %>
<h1>Stats</h1>

<% if (!hasAnyData) { %>
  <div class="card">
    <p class="muted">No scoring data yet. Once matches are played on a round with a course assigned, everyone's birdies/eagles/pars show up here automatically.</p>
  </div>
<% } else { %>

<div class="grid-2">
  <% if (mostBirdies && mostBirdies.birdie > 0) { %>
    <div class="card">
      <h2>🐦 Most Birdies</h2>
      <p style="font-size:1.4rem; font-weight:900;"><%= mostBirdies.name %> <span class="muted" style="font-size:1rem;">— <%= mostBirdies.birdie %></span></p>
    </div>
  <% } %>
  <% if (mostEagles) { %>
    <div class="card">
      <h2>🦅 Most Eagles</h2>
      <p style="font-size:1.4rem; font-weight:900;"><%= mostEagles.name %> <span class="muted" style="font-size:1rem;">— <%= mostEagles.eagle %></span></p>
    </div>
  <% } %>
</div>
<% if (bestAvg) { %>
  <div class="card">
    <h2>🎯 Best Scoring Average (min. 3 holes tracked)</h2>
    <p style="font-size:1.4rem; font-weight:900;"><%= bestAvg.name %> <span class="muted" style="font-size:1rem;">— <%= (bestAvg.totalDiff / bestAvg.played >= 0 ? '+' : '') + (bestAvg.totalDiff / bestAvg.played).toFixed(2) %> to par / hole</span></p>
  </div>
<% } %>

<div class="card">
  <h2>Group Leaderboard</h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th>Player</th><th>Holes</th><th>🦅</th><th>🐦</th><th>Par</th><th>Bogey</th><th>Worse</th></tr></thead>
    <tbody>
      <% leaderboard.forEach(function(p) { %>
        <tr>
          <td><a href="/players/<%= p.userId %>"><%= p.name %></a></td>
          <td><%= p.played %></td>
          <td><%= p.eagle + p.albatross %></td>
          <td><%= p.birdie %></td>
          <td><%= p.par %></td>
          <td><%= p.bogey %></td>
          <td><%= p.worse %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>

<% } %>

<%- include('partials/footer') %>
