<% var title = 'Photos'; var active = 'photos' %>
<%- include('partials/header') %>
<h1>Photos</h1>
<p class="muted small">One vote each for your favourite — voting for a different one just moves your vote.</p>

<% if (!user.readOnly) { %>
<div class="card">
  <h2>Add a photo</h2>
  <% if (error) { %><div class="error-box"><%= error %></div><% } %>
  <form method="post" action="/photos" enctype="multipart/form-data">
    <div class="field"><label>Photo</label><input type="file" name="photo" accept="image/*" required /></div>
    <div class="field"><label>Caption (optional)</label><input type="text" name="caption" placeholder="18th green celebration" /></div>
    <button class="btn" type="submit">Upload</button>
  </form>
</div>
<% } %>

<div class="card">
  <% if (!photos.length) { %>
    <p class="muted">No photos yet — be the first to add one!</p>
  <% } else { %>
    <div class="photo-grid">
      <% photos.forEach(function(p) { %>
        <div class="photo-item">
          <% if (p.isTop) { %><span class="tag" style="position:absolute; margin:8px;">🏆 Photo of the day</span><% } %>
          <img class="photo-thumb" src="/uploads/<%= p.filename %>" alt="<%= p.caption || '' %>" data-full="/uploads/<%= p.filename %>" data-caption="<%= p.caption || '' %>" />
          <div class="photo-caption">
            <%= p.caption || '' %><% if (p.caption) { %><br/><% } %>
            <span class="muted"><%= p.uploader_name || 'Someone' %></span>
            <% if (p.uploaded_by === user.id || user.isCaptain) { %>
              · <form method="post" action="/photos/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this photo?')">
                  <button type="submit" style="background:none;border:none;color:var(--red);cursor:pointer;padding:0;font:inherit;">delete</button>
                </form>
            <% } %>
            <div class="flex gap mt" style="align-items:center;">
              <form method="post" action="/photos/<%= p.id %>/vote">
                <button class="btn small <%= p.isMyVote ? '' : 'secondary' %>" type="submit"><%= p.isMyVote ? '✓ Your vote' : '♥ Vote' %></button>
              </form>
              <span class="small muted"><%= p.voteCount %> vote<%= p.voteCount === 1 ? '' : 's' %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div id="lightbox" class="lightbox" hidden>
  <button type="button" class="lightbox-close" aria-label="Close">✕</button>
  <img id="lightbox-img" src="" alt="" />
  <div id="lightbox-caption" class="lightbox-caption"></div>
</div>

<script>
(function () {
  // Live-ish vote tally without yanking the upload form out from under
  // someone mid-fill -- same fix as the old Bets page's propose-bet bug:
  // pause the reload while the form has unsaved input, resume once it's
  // been left alone or actually submitted.
  var form = document.querySelector('form[action="/photos"]');
  var touched = false;
  if (form) {
    ['input', 'change'].forEach(function (evt) {
      form.addEventListener(evt, function () { touched = true; });
    });
    form.addEventListener('submit', function () { touched = false; });
  }
  setInterval(function () {
    if (!touched) location.reload();
  }, 20000);

  // Tap a thumbnail to view it full-size.
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var lightboxCaption = document.getElementById('lightbox-caption');
  function openLightbox(src, caption) {
    lightboxImg.src = src;
    lightboxCaption.textContent = caption || '';
    lightbox.hidden = false;
  }
  function closeLightbox() {
    lightbox.hidden = true;
    lightboxImg.src = '';
  }
  document.querySelectorAll('.photo-thumb').forEach(function (img) {
    img.addEventListener('click', function () {
      openLightbox(img.getAttribute('data-full'), img.getAttribute('data-caption'));
    });
  });
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) closeLightbox(); // tap the dark backdrop, not the image itself
  });
  document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeLightbox();
  });
})();
</script>

<%- include('partials/footer') %>
