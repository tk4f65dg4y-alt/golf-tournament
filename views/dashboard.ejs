<% var title = 'Leaderboard'; var active = 'home' %>
<%- include('partials/header') %>

<% if (teams.length < 2) { %>
  <div class="card">
    <h1>Welcome, <%= user.name.split(' ')[0] %> 👋</h1>
    <p>This tournament isn't set up yet.
      <% if (user.is_admin) { %>Head to <a href="/admin">Admin</a> to create your two teams, then <a href="/rounds">Rounds</a> to schedule matches.
      <% } else { %>Ask your organizer to set up teams and rounds.<% } %>
    </p>
  </div>
<% } else {
  var t1 = teams[0], t2 = teams[1];
  var pct = pointsTotal ? Math.round((pointsPlayed / pointsTotal) * 100) : 0;
%>
  <div class="scoreboard" style="--team1-color: <%= t1.color %>; --team2-color: <%= t2.color %>;">
    <div class="score-hero">
      <div class="team-score" style="color: <%= t1.color %>">
        <div class="flag" style="background: <%= t1.color %>"></div>
        <div class="num"><%= teamTotals[t1.id] || 0 %></div>
        <div class="label" style="color: var(--ink)"><%= t1.name %></div>
        <% if (t1.captainName) { %><div class="captain">👑 Capt. <%= t1.captainName %></div><% } %>
      </div>
      <div class="vs">VS</div>
      <div class="team-score" style="color: <%= t2.color %>">
        <div class="flag" style="background: <%= t2.color %>"></div>
        <div class="num"><%= teamTotals[t2.id] || 0 %></div>
        <div class="label" style="color: var(--ink)"><%= t2.name %></div>
        <% if (t2.captainName) { %><div class="captain">👑 Capt. <%= t2.captainName %></div><% } %>
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin: 14px 0 0; text-transform: uppercase; letter-spacing: 0.04em; font-weight:700;">
      <%= pointsPlayed %> of <%= pointsTotal %> points decided
    </p>
    <div class="progress-track"><div class="progress-fill" style="width: <%= pct %>%"></div></div>
  </div>
<% } %>

<% if (liveMatches.length) { %>
  <div class="ticker-wrap">
    <div class="ticker-track">
      <% [1,2].forEach(function() { %>
        <% liveMatches.forEach(function(m) { %>
          <span class="ticker-item"><span class="dot"></span><%= m.round_name %>: <%= playerNames(m.side1) %> vs <%= playerNames(m.side2) %> — <%= m.closed_note || 'in progress' %></span>
        <% }) %>
      <% }) %>
    </div>
  </div>
<% } %>

<% if (liveMatches.length) { %>
  <div class="card">
    <h2>🔴 Live matches</h2>
    <% liveMatches.forEach(function(m) { %>
      <a href="/matches/<%= m.id %>" style="text-decoration:none; color:inherit;">
        <div class="match-row">
          <div>
            <div class="small muted"><%= m.round_name %> · <%= m.format %></div>
            <div class="match-side"><%= playerNames(m.side1) %> <span class="muted">vs</span> <%= playerNames(m.side2) %></div>
          </div>
          <div class="match-status"><span class="pill live">LIVE</span><br/><%= m.closed_note || '' %></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<% if (upcomingMatches.length) { %>
  <div class="card">
    <h2>Upcoming matches</h2>
    <% upcomingMatches.forEach(function(m) { %>
      <a href="/matches/<%= m.id %>" style="text-decoration:none; color:inherit;">
        <div class="match-row">
          <div>
            <div class="small muted"><%= m.round_name %> · <%= m.format %></div>
            <div class="match-side"><%= playerNames(m.side1) || 'TBD' %> <span class="muted">vs</span> <%= playerNames(m.side2) || 'TBD' %></div>
          </div>
          <div class="match-status"><span class="pill scheduled">Not started</span></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<% if (completeMatches.length) { %>
  <div class="card">
    <h2>Completed matches</h2>
    <% completeMatches.forEach(function(m) { %>
      <a href="/matches/<%= m.id %>" style="text-decoration:none; color:inherit;">
        <div class="match-row">
          <div>
            <div class="small muted"><%= m.round_name %> · <%= m.format %></div>
            <div class="match-side"><%= playerNames(m.side1) %> <span class="muted">vs</span> <%= playerNames(m.side2) %></div>
          </div>
          <div class="match-status"><span class="pill complete"><%= m.closed_note %></span></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<div class="grid-2">
  <div class="card">
    <div class="flex between"><h2 class="mb0">Recent photos</h2><a class="small" href="/photos">See all →</a></div>
    <% if (!recentPhotos.length) { %><p class="muted small">No photos yet.</p><% } else { %>
      <div class="photo-grid">
        <% recentPhotos.forEach(function(p) { %>
          <div class="photo-item"><img src="/uploads/<%= p.filename %>" alt="" /></div>
        <% }) %>
      </div>
    <% } %>
  </div>
  <div class="card">
    <div class="flex between"><h2 class="mb0">Open side bets</h2><a class="small" href="/sidebets">See all →</a></div>
    <% if (!openBets.length) { %><p class="muted small">No open bets.</p><% } else { %>
      <% openBets.forEach(function(b) { %>
        <div class="match-row">
          <div><%= b.description %><div class="small muted"><%= b.wager || '' %></div></div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
