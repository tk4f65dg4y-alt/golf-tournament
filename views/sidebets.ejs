<% var title = 'Side Bets'; var active = 'sidebets' %>
<%- include('partials/header') %>
<h1>Side Bets</h1>

<div class="card">
  <h2>New side bet</h2>
  <form method="post" action="/sidebets">
    <div class="field"><label>Description</label><input type="text" name="description" required placeholder="Closest to the pin, 14th hole" /></div>
    <div class="field"><label>Wager (optional)</label><input type="text" name="wager" placeholder="$5, loser buys beer, etc." /></div>
    <div class="field">
      <label>Participants (optional)</label>
      <div class="checkbox-list">
        <% users.forEach(function(u) { %>
          <label><input type="checkbox" name="participants" value="<%= u.id %>" /> <%= u.name %></label>
        <% }) %>
      </div>
    </div>
    <button class="btn" type="submit">Add bet</button>
  </form>
</div>

<% bets.forEach(function(b) { %>
  <div class="card">
    <div class="flex between">
      <h3 class="mb0"><%= b.description %></h3>
      <span class="pill <%= b.status === 'open' ? 'scheduled' : 'complete' %>"><%= b.status %></span>
    </div>
    <p class="small muted"><%= b.wager || '' %><% if (b.wager) { %> · <% } %>started by <%= b.created_by_name || 'someone' %></p>
    <% if (b.participants.length) { %>
      <p class="small">Participants: <%= b.participants.map(p=>p.name).join(', ') %></p>
    <% } %>

    <% if (b.status === 'settled') { %>
      <p class="small"><strong>Winner:</strong> <%= b.winner_name || '—' %></p>
      <form method="post" action="/sidebets/<%= b.id %>/reopen" style="display:inline">
        <button class="btn secondary small" type="submit">Reopen</button>
      </form>
    <% } else { %>
      <form method="post" action="/sidebets/<%= b.id %>/settle" class="flex gap wrap mt">
        <select name="winner_user_id" style="width:auto;">
          <option value="">— pick winner —</option>
          <% (b.participants.length ? b.participants : users).forEach(function(u) { %>
            <option value="<%= u.id %>"><%= u.name %></option>
          <% }) %>
        </select>
        <button class="btn small" type="submit">Settle</button>
      </form>
    <% } %>
    <% if (b.created_by === user.id || user.is_admin) { %>
      <form method="post" action="/sidebets/<%= b.id %>/delete" class="mt" onsubmit="return confirm('Delete this bet?')">
        <button class="btn danger small" type="submit">Delete</button>
      </form>
    <% } %>
  </div>
<% }) %>

<% if (!bets.length) { %><div class="card"><p class="muted">No side bets yet.</p></div><% } %>

<%- include('partials/footer') %>
