<% var title = 'Courses'; var active = 'courses' %>
<%- include('partials/header') %>
<h1>Courses</h1>

<% [church, village].forEach(function(c) { %>
  <div class="card">
    <h2><%= c.name %></h2>
    <p class="muted small"><%= c.tees[0].toUpperCase() + c.tees.slice(1) %> tees · Par <%= c.par %> · <%= c.yards.toLocaleString() %> yards</p>
    <table>
      <thead><tr><th>Hole</th><th>Par</th><th>Yds</th><th>SI</th></tr></thead>
      <tbody>
        <% c.holes.forEach(function(h) { %>
          <tr><td><%= h.number %></td><td><%= h.par %></td><td><%= h.yards %></td><td><%= h.strokeIndex %></td></tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr style="font-weight:700;">
          <td>Total</td>
          <td><%= c.par %></td>
          <td><%= c.yards.toLocaleString() %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <p class="small muted mt">Difficulty order, hardest first: <%= c.difficultyOrder.join(', ') %></p>
  </div>
<% }) %>

<%- include('partials/footer') %>
