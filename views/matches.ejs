<% var title = 'Matches'; var active = 'matches' %>
<%- include('partials/header') %>
<h1>Matches</h1>
<p><a class="btn small" href="/matches/new">+ Start a new match</a></p>

<div class="card">
  <% if (!bundles.length) { %>
    <p class="muted small">No matches yet — start the first one.</p>
  <% } %>
  <% bundles.forEach(function(b) { %>
    <a href="/matches/<%= b.match.id %>" style="text-decoration:none; color:inherit;">
      <div class="match-row">
        <div style="flex:1;">
          <div class="small muted">Match <%= b.match.id %> · <%= b.course.name %></div>
          <div class="match-side"><%= b.sideAPlayers.map(p=>p.name).join(' & ') %> <span class="muted">v</span> <%= b.sideBPlayers.map(p=>p.name).join(' & ') %></div>
        </div>
        <div class="match-status"><%= matchStateText(b) %></div>
      </div>
    </a>
  <% }) %>
</div>

<%- include('partials/footer') %>
