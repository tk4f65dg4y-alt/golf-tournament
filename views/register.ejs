<% var title = 'Register' %>
<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="auth-logo">⛳</div>
  <div class="card">
    <h1>Join the tournament</h1>
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <form method="post" action="/register">
      <div class="field">
        <label>Full name</label>
        <input type="text" name="name" required value="<%= form.name || '' %>" autocomplete="name" />
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="email" />
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required minlength="6" autocomplete="new-password" />
      </div>
      <div class="field">
        <label>Invite code</label>
        <input type="text" name="invite_code" value="<%= form.invite_code || '' %>" placeholder="Ask the organizer" />
      </div>
      <button class="btn block" type="submit">Create account</button>
    </form>
    <p class="small mt">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>
<%- include('partials/footer') %>
