<% var title = 'Match ' + b.match.id; var active = 'matches' %>
<%- include('partials/header') %>
<p><a href="/matches">← All matches</a></p>

<% var conflictHoles = Object.keys(b.conflicts); %>
<% if (conflictHoles.length) { %>
<div class="card" style="border: 2px solid var(--red);">
  <p class="mb0" style="font-weight:700;">⚠ <%= conflictHoles.length %> hole<%= conflictHoles.length === 1 ? '' : 's' %> here have conflicting scores from two different people — held out of the result until a captain resolves it.</p>
</div>
<% } %>

<div class="card">
  <span class="tag"><%= b.match.format === 'singles' ? 'Singles' : 'Fourball' %></span>
  <span class="tag"><%= b.course.name %> · <%= b.match.holeCount %> holes</span>
  <span class="tag">Group <%= b.match.teeGroup %></span>
  <div class="score-hero mt">
    <div class="team-score" style="color: var(--casey)">
      <div class="num"><%= b.state.holesPlayed ? (b.state.leadingSide === 'A' ? b.state.diff : (b.state.leadingSide === 'B' ? '–' + b.state.diff : 'AS')) : '–' %></div>
      <div class="label" style="color:var(--ink)"><%= b.sideAPlayers.map(p=>p.name).join(' & ') %></div>
    </div>
    <div class="vs">v</div>
    <div class="team-score" style="color: var(--reggel)">
      <div class="num"><%= b.state.holesPlayed ? (b.state.leadingSide === 'B' ? b.state.diff : (b.state.leadingSide === 'A' ? '–' + b.state.diff : 'AS')) : '–' %></div>
      <div class="label" style="color:var(--ink)"><%= b.sideBPlayers.map(p=>p.name).join(' & ') %></div>
    </div>
  </div>
  <p style="text-align:center; font-weight:700; margin-top:10px;">
    <% if (b.state.isComplete) { %><span class="pill complete">Final: <%= b.state.closedResult %></span>
    <% } else { %><span class="pill live"><%= b.state.holesPlayed > 0 ? 'LIVE' : 'NOT STARTED' %></span> <%= matchStateText(b) %><% } %>
  </p>
  <% if (canScore) { %>
    <a class="btn block mt" href="/matches/<%= b.match.id %>/score?hole=<%= Math.min(b.state.holesPlayed + 1, b.match.holeCount) %>">
      <%= b.state.isComplete ? 'Review scorecard' : 'Score this match →' %>
    </a>
  <% } %>
</div>

<div class="card">
  <h2>Shots given</h2>
  <p class="small muted">Everyone plays off their own course handicap, hardest holes first — fixed relative to Casey (scratch), not re-based to whoever's lowest in this particular match.</p>
  <% b.allPlayers.forEach(function(p) { %>
    <% var holes = Object.entries(b.allocations[p.id]).filter(([,n]) => n > 0).sort((x,y)=>x[0]-y[0]); %>
    <div class="match-row">
      <div><%= p.isCaptain ? '👑 ' : '' %><%= p.name %></div>
      <div class="small">
        <% if (!holes.length) { %><span class="muted">Scratch</span>
        <% } else { %><%= holes.map(([h,n]) => n > 1 ? `${h} (×${n})` : h).join(', ') %><% } %>
      </div>
    </div>
  <% }) %>
</div>

<% if (b.state.holesPlayed > 0) { %>
<div class="card">
  <h2>Hole by hole</h2>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Hole</th><th>Par</th><th>SI</th>
        <% b.allPlayers.forEach(function(p) { %><th><%= p.name.split(' ')[0] %></th><% }) %>
        <th>Result</th>
      </tr>
    </thead>
    <tbody>
      <% b.courseHoles.forEach(function(ch) { %>
        <% var h = ch.number; var winner = b.state.resultForHole(h); %>
        <tr>
          <td><%= h %></td><td><%= ch.par %></td><td><%= ch.strokeIndex %></td>
          <% b.allPlayers.forEach(function(p) { %>
            <% var gross = b.scores[h] ? b.scores[h][p.id] : undefined; var shots = b.allocations[p.id][h] || 0; %>
            <% var conflict = b.conflicts[h] && b.conflicts[h][p.id]; %>
            <td>
              <% if (conflict) { %><span class="bad" style="font-weight:800;" title="Conflict: <%= conflict.gross %> vs <%= conflict.conflictGross %>">⚠</span>
              <% } else if (gross === undefined) { %><span class="muted">–</span>
              <% } else if (gross === null) { %><span class="muted">PU</span>
              <% } else { %><%= gross %><% if (shots) { %><span class="muted small"> (<%= gross - shots %>)</span><% } %><% } %>
            </td>
          <% }) %>
          <td>
            <% if (winner === 'A') { %><span class="pill casey">Casey</span>
            <% } else if (winner === 'B') { %><span class="pill reggel">Reggel</span>
            <% } else if (winner === 'half') { %><span class="tag">½</span>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <p class="small muted mt">Numbers in brackets are net score after shots.</p>
</div>
<% } %>

<%- include('partials/footer') %>
