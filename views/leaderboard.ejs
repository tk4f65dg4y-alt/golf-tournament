<% var title = 'Leaderboard'; var active = 'leaderboard' %>
<%- include('partials/header') %>
<meta http-equiv="refresh" content="20" />
<h1>Leaderboard</h1>
<p class="muted small">Everyone, ranked by overall record — a win is worth 1 point, a half 0.5, across every match played, regardless of who it was against.</p>

<div class="card">
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>#</th><th>Player</th><th>Played</th><th>W</th><th>L</th><th>H</th><th>Points</th></tr>
      </thead>
      <tbody>
        <% standings.forEach(function(r, i) { %>
          <tr>
            <td><%= r.played ? (i + 1) : '–' %></td>
            <td><%= r.player.isCaptain ? '👑 ' : '' %><%= r.player.name %></td>
            <td><%= r.played %></td>
            <td><%= r.wins %></td>
            <td><%= r.losses %></td>
            <td><%= r.halves %></td>
            <td style="font-weight:800;"><%= r.points %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="small muted mt mb0">Not started any matches yet? You'll show up here as soon as one's decided.</p>
</div>

<div class="card">
  <h2 class="mb0">All matches</h2>
  <% if (!bundles.length) { %>
    <p class="small muted mt">Nobody's started a match yet.</p>
  <% } %>
  <% bundles.forEach(function(b) { %>
    <a href="/matches/<%= b.match.id %>" style="text-decoration:none; color:inherit;">
      <div class="match-row">
        <div style="flex:1;">
          <div class="match-side"><%= b.sideAPlayers.map(p=>p.name).join(' & ') %> <span class="muted">v</span> <%= b.sideBPlayers.map(p=>p.name).join(' & ') %></div>
          <div class="small muted"><%= b.course.name %> · <%= matchStateText(b) %></div>
        </div>
        <div class="match-status">
          <% if (b.state.isComplete) { %><span class="pill complete">Final</span>
          <% } else if (b.state.holesPlayed > 0) { %><span class="pill live">LIVE</span>
          <% } else { %><span class="pill scheduled">Not started</span><% } %>
        </div>
      </div>
    </a>
  <% }) %>
  <a class="small mt" style="display:inline-block;" href="/matches/new">+ Start a new match</a>
</div>

<%- include('partials/footer') %>
