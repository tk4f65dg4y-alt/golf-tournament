# Postgres connection string. Railway injects this automatically when you
# attach a Postgres database to this service — you usually don't set it by hand.
DATABASE_URL=postgres://user:password@localhost:5432/aldenham_cup

# Set to "true" if your Postgres provider requires SSL (most managed/public
# Postgres connections do; Railway's private network usually doesn't).
PGSSL=false

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-random

# Where uploaded photos are stored on disk. On Railway, mount a volume at
# this path so photos survive redeploys.
UPLOAD_DIR=./uploads

# Set to "true" only if this app is NOT sitting behind a TLS-terminating
# reverse proxy (Railway, etc.) — disables the "secure" session cookie flag.
DISABLE_SECURE_COOKIE=false

NODE_ENV=production
